# =============================================================================
# .env  —  Docker Compose variable overrides
# Copy this file to .env and fill in real values before running:
#   docker compose up -d --build
#
# This file is loaded automatically by Docker Compose.
# NEVER commit a .env with real secrets to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# MongoDB
# ---------------------------------------------------------------------------
MONGO_ROOT_USER=mongoAdmin
MONGO_ROOT_PASS=changeme_use_strong_password

# ---------------------------------------------------------------------------
# API Server
# ---------------------------------------------------------------------------
PORT=8000
JWT_SECRET=replace_with_long_random_secret_min_32_chars

# Super-admin account seeded on first boot
SUPER_ADMIN_NAME=Esrom
SUPER_ADMIN_EMAIL=12yemom@gmail.com
SUPER_ADMIN_PASSWORD=12345678


APP_NAME=Gulit
# Restrict to your frontend origin in production, e.g. https://gulit.app
CORS_ORIGIN=*

# ---------------------------------------------------------------------------
# SMTP (optional — email features degrade gracefully when empty)
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=12yemom@gmail.com
SMTP_PASS=12345678
EMAIL_FROM=12yemom@gmail.com
