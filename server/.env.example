# Copy this file to server/.env and fill in production values.
# NEVER commit real secrets to version control.

# Server
PORT=8000
JWT_SECRET=your_jwt_secret_here
APP_NAME=Gulit

# Super-admin seeded on first boot
SUPER_ADMIN_NAME=Admin
SUPER_ADMIN_EMAIL=owner@example.com
SUPER_ADMIN_PASSWORD=ChangeMe123!

# MongoDB connection used when running the backend manually.
# If you run the app with Docker Compose, the compose file overrides this.
MONGODB_URI=

# If you run the included local mongo service, set these root creds instead.
MONGO_ROOT_USER=mongoAdmin
MONGO_ROOT_PASS=changeme

# CORS
# Flutter web uses a random localhost port during `flutter run`, so allow all
# local origins in development. Tighten this for production deployments.
CORS_ORIGIN=*

# SMTP (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
